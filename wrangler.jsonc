{
  "name": "jordanforfisd",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "SIGNUPS", "id": "b85a9914e2474a1f9ba4cbba69446ce0" }
  ],
  "routes": [
    { "pattern": "jordanforfisd.com", "custom_domain": true },
    { "pattern": "www.jordanforfisd.com", "custom_domain": true }
  ]
}
